(kicad_wks
	(version 20231118)
	(generator "pl_editor")
	(generator_version "10.0")
	(setup
		(textsize 1.5 1.5)
		(linewidth 0.15)
		(textlinewidth 0.15)
		(left_margin 10)
		(right_margin 10)
		(top_margin 10)
		(bottom_margin 10)
	)
	(rect
		(name "")
		(start 71.989 30.5022)
		(end 1.989 2.0022)
		(comment "rect around the title block")
	)
	(rect
		(name "")
		(start 0 0 ltcorner)
		(end 0 0)
		(repeat 2)
		(incrx 2)
		(incry 2)
	)
	(line
		(name "")
		(start 50 2 ltcorner)
		(end 50 0 ltcorner)
		(repeat 30)
		(incrx 50)
	)
	(tbtext "1"
		(name "")
		(pos 25 1 ltcorner)
		(font
			(size 1.3 1.3)
		)
		(repeat 100)
		(incrx 50)
	)
	(line
		(name "")
		(start 50 2 lbcorner)
		(end 50 0 lbcorner)
		(repeat 30)
		(incrx 50)
	)
	(tbtext "1"
		(name "")
		(pos 25 1 lbcorner)
		(font
			(size 1.3 1.3)
		)
		(repeat 100)
		(incrx 50)
	)
	(line
		(name "")
		(start 0 50 ltcorner)
		(end 2 50 ltcorner)
		(repeat 30)
		(incry 50)
	)
	(tbtext "A"
		(name "")
		(pos 1 25 ltcorner)
		(font
			(size 1.3 1.3)
		)
		(justify center)
		(repeat 100)
		(incry 50)
	)
	(line
		(name "")
		(start 0 50 rtcorner)
		(end 2 50 rtcorner)
		(repeat 30)
		(incry 50)
	)
	(tbtext "A"
		(name "")
		(pos 1 25 rtcorner)
		(font
			(size 1.3 1.3)
		)
		(justify center)
		(repeat 100)
		(incry 50)
	)
	(tbtext "Date: ${ISSUE_DATE}"
		(name "")
		(pos 71 15.9002)
	)
	(line
		(name "")
		(start 72 14.5002)
		(end 1.989 14.5022)
	)
	(tbtext "${KICAD_VERSION}"
		(name "")
		(pos 71 13.1002)
		(comment "Kicad version")
	)
	(line
		(name "")
		(start 72 17.5002)
		(end 1.989 17.5022)
	)
	(tbtext "Size: ${PAPER}"
		(name "")
		(pos 71 9.9002)
		(comment "Paper format name")
	)
	(line
		(name "")
		(start 72 21.5002)
		(end 1.989 21.5022)
	)
	(tbtext "Title: ${TITLE}"
		(name "")
		(pos 71 19.7002)
		(font
			(size 2 2) bold italic)
	)
	(tbtext "File: ${FILENAME}"
		(name "")
		(pos 71 23.3002)
	)
	(line
		(name "")
		(start 72 27.5002)
		(end 1.989 27.5022)
	)
	(tbtext "Sheet: ${SHEETPATH}"
		(name "")
		(pos 71 26.0002)
	)
	(tbtext "${COMPANY}"
		(name "")
		(pos 71 29.0002)
		(font bold)
		(comment "Company name")
	)
	(line
		(name "")
		(start 71.989 11.5022)
		(end 1.989 11.5022)
	)
	(line
		(name "")
		(start 71.989 8.0022)
		(end 1.989 8.0022)
	)
	(tbtext "Rev: ${REVISION}"
		(name "")
		(pos 70.989 6.5022)
		(font bold)
	)
	(line
		(name "")
		(start 71.989 5.0022)
		(end 1.989 5.0022)
	)
	(tbtext "Id: ${#}/${##}"
		(name "")
		(pos 70.989 3.5022)
		(comment "Sheet id")
	)
)
